function RevisionCard({ state, setState, progress }) {
  const [newSubject, setNewSubject] = useState("");

  const totalHours = state.subjects.reduce((a, s) => a + s.hoursLogged, 0);
  const totalTopics = state.subjects.flatMap((s) => s.subtopics).length;
  const doneTopics = state.subjects.flatMap((s) => s.subtopics).filter((t) => t.done).length;

  const addSubject = () => {
    if (!newSubject.trim()) return;
    setState((s) => ({
      ...s,
      subjects: [...s.subjects, {
        id: `s${Date.now()}`,
        name: newSubject.trim(),
        hoursLogged: 0,
        expanded: true,
        subtopics: [],
      }],
    }));
    setNewSubject("");
  };

  const updateSubject = (id, patch) => {
    setState((s) => ({
      ...s,
      subjects: s.subjects.map((sub) => sub.id === id ? { ...sub, ...patch } : sub),
    }));
  };

  const removeSubject = (id) => {
    setState((s) => ({ ...s, subjects: s.subjects.filter((sub) => sub.id !== id) }));
  };

  const addSubtopic = (subjectId, title) => {
    if (!title.trim()) return;
    setState((s) => ({
      ...s,
      subjects: s.subjects.map((sub) =>
        sub.id === subjectId
          ? { ...sub, subtopics: [...sub.subtopics, { id: `st${Date.now()}`, title: title.trim(), done: false }] }
          : sub
      ),
    }));
  };

  const toggleSubtopic = (subjectId, topicId) => {
    setState((s) => ({
      ...s,
      subjects: s.subjects.map((sub) =>
        sub.id === subjectId
          ? { ...sub, subtopics: sub.subtopics.map((t) => t.id === topicId ? { ...t, done: !t.done } : t) }
          : sub
      ),
    }));
  };

  const removeSubtopic = (subjectId, topicId) => {
    setState((s) => ({
      ...s,
      subjects: s.subjects.map((sub) =>
        sub.id === subjectId
          ? { ...sub, subtopics: sub.subtopics.filter((t) => t.id !== topicId) }
          : sub
      ),
    }));
  };

  const adjustHours = (id, delta) => {
    setState((s) => ({
      ...s,
      subjects: s.subjects.map((sub) =>
        sub.id === id ? { ...sub, hoursLogged: Math.max(0, Math.round((sub.hoursLogged + delta) * 4) / 4) } : sub
      ),
    }));
  };

  return (
    <Card accent={COLORS.revision} className="p-5 md:p-6">
      <div className="flex items-start justify-between mb-5">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <BookOpen size={14} style={{ color: COLORS.revision }} />
            <Label color={COLORS.revision}>Pillar 02 · Revision</Label>
          </div>
          <h2 className="font-light" style={{ fontSize: 22, color: COLORS.text }}>
            Subject Mastery
          </h2>
        </div>
        <div className="text-right">
          <div className="font-light tabular-nums" style={{ fontSize: 24, color: COLORS.revision }}>
            {progress.toFixed(0)}%
          </div>
          <Label>Topics Done</Label>
        </div>
      </div>

      <ProgressBar value={progress} color={COLORS.revision} />

      <div className="grid grid-cols-3 gap-2 mt-5">
        <Stat label="Subjects" value={state.subjects.length} color={COLORS.revision} />
        <Stat label="Topics" value={`${doneTopics}/${totalTopics}`} color={COLORS.revision} />
        <Stat label="Hours" value={fmtNum(totalHours, 1)} color={COLORS.revision} />
      </div>

      {/* Add subject */}
      <div className="mt-4 flex gap-2">
        <input
          value={newSubject}
          onChange={(e) => setNewSubject(e.target.value)}
          onKeyDown={(e) => e.key === "Enter" && addSubject()}
          placeholder="Add subject / module…"
          className="flex-1 px-3 py-2 rounded-md border outline-none text-sm"
          style={{ background: COLORS.bg, borderColor: COLORS.border, color: COLORS.text }}
        />
        <button
          onClick={addSubject}
          className="px-3 py-2 rounded-md font-mono uppercase tracking-wider"
          style={{ background: COLORS.revision, color: "#003746", fontSize: 11, letterSpacing: "0.12em" }}
        >
          Add
        </button>
      </div>

      {/* Subject list */}
      <div className="mt-4 space-y-2">
        {state.subjects.map((sub) => {
          const subDone = sub.subtopics.filter((t) => t.done).length;
          const subTotal = sub.subtopics.length;
          const subPct = subTotal ? (subDone / subTotal) * 100 : 0;
          return (
            <SubjectRow
              key={sub.id}
              sub={sub}
              subDone={subDone}
              subTotal={subTotal}
              subPct={subPct}
              onUpdate={(patch) => updateSubject(sub.id, patch)}
              onRemove={() => removeSubject(sub.id)}
              onAddTopic={(title) => addSubtopic(sub.id, title)}
              onToggleTopic={(topicId) => toggleSubtopic(sub.id, topicId)}
              onRemoveTopic={(topicId) => removeSubtopic(sub.id, topicId)}
              onAdjustHours={(delta) => adjustHours(sub.id, delta)}
            />
          );
        })}
      </div>

      <div className="mt-5 pt-5 border-t" style={{ borderColor: COLORS.border }}>
        <Label>Method · Active Recall</Label>
        <div className="mt-3 space-y-2 text-xs leading-relaxed" style={{ color: COLORS.muted }}>
          <p><span style={{ color: COLORS.revision }}>·</span> Don't re-read notes — close the book and self-test. Recall > review.</p>
          <p><span style={{ color: COLORS.revision }}>·</span> Spaced repetition: revisit a topic 1d, 3d, 7d, 14d after first study.</p>
          <p><span style={{ color: COLORS.revision }}>·</span> 50/10 — focus blocks of 50 min, then 10 min walk. No phone during the 50.</p>
          <p><span style={{ color: COLORS.revision }}>·</span> One past paper a week beats five hours of passive reading.</p>
        </div>
      </div>
    </Card>
  );
}

