// ─── MAIN COMPONENT ────────────────────────────────────────────────────────────
export default function JuneSprintDashboard() {
  const [state, setState] = useState(DEFAULT_STATE);
  const [loaded, setLoaded] = useState(false);
  const [activeTab, setActiveTab] = useState("all"); // all | physique | revision | coding
  const saveTimer = useRef(null);

  const { days, hours, minutes, seconds, now } = useCountdown(TARGET_DATE);

  // Load persistent state
  useEffect(() => {
    (async () => {
      try {
        if (typeof window !== "undefined" && window.storage) {
          const r = await window.storage.get(STORAGE_KEY);
          if (r?.value) {
            const parsed = JSON.parse(r.value);
            setState((s) => ({ ...s, ...parsed }));
          }
        }
      } catch (e) { /* first run */ }
      setLoaded(true);
    })();
  }, []);

  // Debounced save
  useEffect(() => {
    if (!loaded) return;
    if (saveTimer.current) clearTimeout(saveTimer.current);
    saveTimer.current = setTimeout(async () => {
      try {
        if (typeof window !== "undefined" && window.storage) {
          await window.storage.set(STORAGE_KEY, JSON.stringify(state));
        }
      } catch (e) { /* swallow */ }
    }, 400);
    return () => saveTimer.current && clearTimeout(saveTimer.current);
  }, [state, loaded]);

  // ─── DERIVED METRICS ──────────────────────────────────────────────────────
  const totalSprintDays = Math.ceil((TARGET_DATE - SPRINT_START) / 86400000);
  const elapsedDays = Math.max(0, Math.min(totalSprintDays, Math.floor((now - SPRINT_START) / 86400000)));
  const sprintProgressPct = (elapsedDays / totalSprintDays) * 100;

  const physiqueProgress = useMemo(() => {
    const startW = parseFloat(state.startWeight);
    const goalW = parseFloat(state.goalWeight);
    const latest = state.weighIns[state.weighIns.length - 1]?.weight;
    if (!Number.isFinite(startW) || !Number.isFinite(goalW) || !Number.isFinite(latest)) return 0;
    if (startW === goalW) return 100;
    const pct = ((startW - latest) / (startW - goalW)) * 100;
    return Math.max(0, Math.min(100, pct));
  }, [state.weighIns, state.startWeight, state.goalWeight]);

  const revisionProgress = useMemo(() => {
    const all = state.subjects.flatMap((s) => s.subtopics);
    if (!all.length) return 0;
    return (all.filter((t) => t.done).length / all.length) * 100;
  }, [state.subjects]);

  const codingProgress = useMemo(() => {
    const moduleAvg = state.modules.reduce((a, m) => a + (m.done ? 100 : m.progress), 0) / state.modules.length;
    const fpDone = state.finalProject.filter((t) => t.done).length / state.finalProject.length * 100;
    return moduleAvg * 0.7 + fpDone * 0.3;
  }, [state.modules, state.finalProject]);

  const overallProgress = (physiqueProgress + revisionProgress + codingProgress) / 3;

  if (!loaded) {
    return (
      <div className="min-h-screen flex items-center justify-center" style={{ background: COLORS.bg }}>
        <div style={{ color: COLORS.muted }} className="font-mono text-sm tracking-widest uppercase">
          Loading sprint…
        </div>
      </div>
    );
  }

  return (
    <div
      className="min-h-screen px-4 py-6 md:px-8 md:py-10"
      style={{ background: COLORS.bg, color: COLORS.text, fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif" }}
    >
      <div className="max-w-7xl mx-auto">
        {/* HEADER */}
        <Header days={days} hours={hours} minutes={minutes} seconds={seconds} now={now} />

        {/* KPI STRIP */}
        <KpiStrip
          sprintProgressPct={sprintProgressPct}
          elapsedDays={elapsedDays}
          totalDays={totalSprintDays}
          daysLeft={days}
          overall={overallProgress}
          physique={physiqueProgress}
          revision={revisionProgress}
          coding={codingProgress}
        />

        {/* TAB FILTER */}
        <TabBar active={activeTab} setActive={setActiveTab} />

        {/* PILLARS */}
        <div
          className={`grid gap-5 mt-5 ${
            activeTab === "all" ? "lg:grid-cols-3" : "grid-cols-1"
          }`}
        >
          {(activeTab === "all" || activeTab === "physique") && (
            <PhysiqueCard state={state} setState={setState} progress={physiqueProgress} />
          )}
          {(activeTab === "all" || activeTab === "revision") && (
            <RevisionCard state={state} setState={setState} progress={revisionProgress} />
          )}
          {(activeTab === "all" || activeTab === "coding") && (
            <CodingCard state={state} setState={setState} progress={codingProgress} />
          )}
        </div>

        {/* FOOTER */}
        <div className="mt-10 pt-6 border-t flex items-center justify-between" style={{ borderColor: COLORS.border }}>
          <Label>June Sprint · v1.0 · Auto-saved</Label>
          <Label>Target: 30 Jun 2026 · 23:59</Label>
        </div>
      </div>
    </div>
  );
}

