        <div className="mt-3 space-y-2 text-xs leading-relaxed" style={{ color: COLORS.muted }}>
          <p><span style={{ color: COLORS.coding }}>·</span> Data: <span style={{ color: COLORS.text }}>yfinance</span> for free, <span style={{ color: COLORS.text }}>Alpha Vantage</span> for fundamentals.</p>
