              <IconButton onClick={() => onAdjustHours(0.25)} title="+15 min"><Plus size={12} /></IconButton>
            </div>
          </div>

          {/* Subtopics */}
          <div className="space-y-1">
            {sub.subtopics.map((t) => (
              <div key={t.id} className="flex items-center gap-2 group">
                <button
                  onClick={() => onToggleTopic(t.id)}
