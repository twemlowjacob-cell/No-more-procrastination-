            <span className="font-mono tabular-nums" style={{ color: COLORS.coding, fontSize: 11, minWidth: 36, textAlign: "center" }}>
              {fmtNum(m.hours, 1)}h
            </span>
            <IconButton onClick={() => onAdjustHours(0.5)} title="+30 min"><Plus size={11} /></IconButton>
          </div>
        </div>
      </div>
    </div>
  );
}

