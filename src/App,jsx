// ─── CODING CARD ───────────────────────────────────────────────────────────────
function CodingCard({ state, setState, progress }) {
  const completedModules = state.modules.filter((m) => m.done).length;
  const totalHours = state.modules.reduce((a, m) => a + m.hours, 0);
  const fpDone = state.finalProject.filter((t) => t.done).length;

  const updateModule = (id, patch) => {
    setState((s) => ({
      ...s,
      modules: s.modules.map((m) => m.id === id ? { ...m, ...patch } : m),
    }));
  };

  const adjustModuleProgress = (id, delta) => {
    setState((s) => ({
      ...s,
      modules: s.modules.map((m) => {
        if (m.id !== id) return m;
        const next = Math.max(0, Math.min(100, m.progress + delta));
        return { ...m, progress: next, done: next >= 100 ? true : m.done };
      }),
    }));
  };

  const toggleModuleDone = (id) => {
    setState((s) => ({
      ...s,
      modules: s.modules.map((m) =>
        m.id === id ? { ...m, done: !m.done, progress: !m.done ? 100 : m.progress } : m
      ),
    }));
  };

  const adjustModuleHours = (id, delta) => {
    setState((s) => ({
      ...s,
      modules: s.modules.map((m) =>
        m.id === id ? { ...m, hours: Math.max(0, Math.round((m.hours + delta) * 2) / 2) } : m
      ),
    }));
  };

  const toggleFpTask = (id) => {
    setState((s) => ({
      ...s,
      finalProject: s.finalProject.map((t) => t.id === id ? { ...t, done: !t.done } : t),
    }));
  };

  return (
    <Card accent={COLORS.coding} className="p-5 md:p-6">
      <div className="flex items-start justify-between mb-5">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <Code2 size={14} style={{ color: COLORS.coding }} />
            <Label color={COLORS.coding}>Pillar 03 · Coding</Label>
          </div>
          <h2 className="font-light" style={{ fontSize: 22, color: COLORS.text }}>
            Python → Auto Portfolio
          </h2>
        </div>
        <div className="text-right">
          <div className="font-light tabular-nums" style={{ fontSize: 24, color: COLORS.coding }}>
            {progress.toFixed(0)}%
          </div>
          <Label>Path Progress</Label>
        </div>
      </div>

      <ProgressBar value={progress} color={COLORS.coding} />

      <div className="grid grid-cols-3 gap-2 mt-5">
        <Stat label="Modules" value={`${completedModules}/${state.modules.length}`} color={COLORS.coding} />
        <Stat label="Hours" value={fmtNum(totalHours, 1)} color={COLORS.coding} />
        <Stat label="Final" value={`${fpDone}/${state.finalProject.length}`} color={COLORS.coding} />
      </div>

      {/* Modules timeline */}
      <div className="mt-5">
        <Label>Learning Path</Label>
        <div className="mt-3 space-y-2 relative">
          {state.modules.map((m, idx) => (
            <ModuleRow
              key={m.id}
              module={m}
              index={idx}
              isLast={idx === state.modules.length - 1}
              onToggleDone={() => toggleModuleDone(m.id)}
              onAdjustProgress={(d) => adjustModuleProgress(m.id, d)}
              onAdjustHours={(d) => adjustModuleHours(m.id, d)}
