}

function NumberInput({ label, value, onChange, color }) {
  return (
    <div
      className="rounded-md border p-2"
      style={{ background: "rgba(255,255,255,0.02)", borderColor: COLORS.border }}
    >
      <Label>{label}</Label>
      <input
        type="number"
        step="0.1"
        value={value}
        onChange={(e) => onChange(e.target.value)}
        placeholder="—"
        className="w-full bg-transparent outline-none mt-1 font-light tabular-nums"
        style={{ fontSize: 16, color }}
      />
    </div>
